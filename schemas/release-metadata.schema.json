{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Release Metadata",
  "type": "object",
  "required": ["version", "date", "releasedBy", "artifacts"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "date": { "type": "string", "format": "date-time" },
    "releasedBy": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "name", "tag", "uri"],
        "properties": {
          "type": { "type": "string" },
          "name": { "type": "string" },
          "tag": { "type": "string" },
          "uri": { "type": "string", "format": "uri" }
        }
      }
    },
    "notes": { "type": "string" },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "summary"],
        "properties": {
          "type": { "type": "string" },
          "summary": { "type": "string" },
          "details": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
